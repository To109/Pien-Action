MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1768922345}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 54e96f86278799143b1620657031099e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  endingContents:
  - endingType: 0
    endingCg: {fileID: -4074104475321235479, guid: 20514c2daf64d2c42a6bd4eaae1ebb50, type: 3}
    storyText: "\u7121\u4E8B\u306B\u5C4A\u3051\u308B\u3053\u3068\u304C\u3067\u304D\u305F\u2026\uFF01\\p\u63D0\u51FA\u3057\u305F\u77AC\u9593\u3001\u7DCA\u5F35\u304C\u4E00\u6C17\u306B\u307B\u3069\u3051\u3066\u6D99\u304C\u3053\u307C\u308C\u305D\u3046\u306B\u306A\u308B\u3002\\p\u5F8C\u65E5\u3001\u5148\u751F\u304B\u3089\u52AA\u529B\u3082\u8A8D\u3081\u3089\u308C\u3066\u79C0\u306E\u5224\u5B9A\u3082\u3082\u3089\u3048\u305F\uFF01\r\n\u300C\u3084\u3063\u305F\u2026\uFF01\u300D\u3068\u601D\u308F\u305A\u5C0F\u3055\u304F\u30AC\u30C3\u30C4\u30DD\u30FC\u30BA\u3002\\p\u9054\u6210\u611F\u3068\u5B89\u5FC3\u611F\u3067\u5FC3\u304C\u6E80\u305F\u3055\u308C\u3001\u6B21\u306E\u8AB2\u984C\u306B\u3082\u81EA\u4FE1\u304C\u6301\u3066\u305D\u3046\u3060\u3002"
  - endingType: 1
    endingCg: {fileID: 6486755913967133123, guid: b4db58fcbd132ad4ca89fa79071c504c, type: 3}
    storyText: "\u306A\u3001\u306A\u3093\u3068\u304B\u9593\u306B\u5408\u3063\u305F\u2026\uFF01\uFF01\\p\u6642\u8A08\u3092\u78BA\u8A8D\u3057\u3066\u307F\u308C\u3070\u3042\u30683\u5206\u3060\u3063\u305F\u3002\r\n\u63D0\u51FA\u76F4\u5F8C\u306E\u5B89\u5835\u304C\u6DF7\u3058\u3063\u305F\u606F\u304C\u80F8\u3092\u6E80\u305F\u3059\u3002\\p\u5F8C\u65E5\u5148\u751F\u304B\u3089\u8A55\u4FA1\u304C\u8FD4\u3063\u3066\u304D\u305F\u3002\u7D50\u679C\u306F\u53EF\u3060\u3063\u305F\u3002\r\n\u300C\u671F\u9650\u304C\u5207\u308C\u3066\u3044\u305F\u3089\u5371\u306A\u304B\u3063\u305F\u2026\u300D\u3068\u81EA\u5206\u306B\u5F37\u304F\u8A00\u3044\u805E\u304B\u305B\u308B\u3002\\p\u3053\u308C\u304B\u3089\u306F\u3082\u3063\u3068\u6C17\u3092\u3064\u3051\u3066\u3001\u4E8C\u5EA6\u3068\u5FD8\u308C\u3082\u306E\u306F\u3057\u306A\u3044\u3088\u3046\u306B\u3057\u3088\u3046\u3002\\p\u3053\u308C\u304C\u6210\u9577\u306E\u4E00\u6B69\u306B\u306A\u3063\u305F\u306E\u304B\u3082\u3057\u308C\u306A\u3044\u3002"
  - endingType: 2
    endingCg: {fileID: -8694169539192331894, guid: fc042475357d8d74b811b4dd102336bb, type: 3}
    storyText: "\u30AD\u30FC\u30F3\u30B3\u30FC\u30F3\u30AB\u30FC\u30F3\u30B3\u30FC\u30F3\\p\u8077\u54E1\u5BA4\u306E\u6238\u3092\u53E9\u3053\u3046\u3068\u3057\u305F\u3068\u304D\u3001\u4ECA\u306E\u81EA\u5206\u3092\u5632\u7B11\u3046\u304B\u306E\u3088\u3046\u306B\u30C1\u30E3\u30A4\u30E0\u304C\u5B66\u5185\u306B\u97FF\u304F\u3002\\p\u300C\u671F\u9650\u3092\u904E\u304E\u3066\u3057\u307E\u3063\u305F\u2026\u2026\u300D\\p\u5446\u7136\u3068\u3057\u305F\u307E\u307E\u5148\u751F\u306B\u63D0\u51FA\u3059\u308B\u3082\u3001\u671F\u9650\u5916\u306E\u305F\u3081\u6E1B\u70B9\u304C\u91CD\u306A\u308A\u3001\u7D50\u679C\u306F\u4E0D\u53EF\u3060\u3063\u305F\u3002\\p\u80F8\u306E\u5965\u304C\u7DE0\u3081\u3064\u3051\u3089\u308C\u308B\u3088\u3046\u306A\u6094\u3057\u3055\u3068\u60B2\u3057\u307F\u304C\u6EA2\u308C\u3001\u601D\u308F\u305A\u6D99\u304C\u6B62\u307E\u3089\u306A\u3044\u3002"
